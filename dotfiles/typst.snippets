global !p
import vim

# One immediately-called Lua chunk, flattened to a single line so it can
# ride inside luaeval(). Returns 1 in math, 0 everywhere else.
IN_MATH = 'luaeval("' + ' '.join("""
(function()
	local ok, parser = pcall(vim.treesitter.get_parser, 0, 'typst')
	if not ok or not parser then return 0 end
	parser:parse(true)
	local pos = { vim.fn.line('.') - 1, math.max(vim.fn.col('.') - 2, 0) }
	local node = vim.treesitter.get_node({ bufnr = 0, pos = pos, lang = 'typst' })
	while node do
		if node:type() == 'math' then return 1 end
		node = node:parent()
	end
	return 0
end)()
""".split()) + '")'

def math():
	return str(vim.eval(IN_MATH)) == '1'
endglobal

# ──────────────────────────────────────────────────────────────────────
# 2. Markup
# ──────────────────────────────────────────────────────────────────────

snippet sec "section" i
= $0
endsnippet

snippet sub "subsection" i
== $0
endsnippet

# Inline math: $x$
snippet mk "inline math" A
\$${1}\$$0
endsnippet

# Display math: a $ with surrounding whitespace renders as a block.
snippet dm "display math" A
\$
$1
\$$0
endsnippet

# Aligned block: & aligns, a single trailing backslash breaks the line.
snippet align "aligned equations" i
\$
$1 &= $2 \
$0
\$
endsnippet

# ──────────────────────────────────────────────────────────────────────
# 3. Inside math only
# ──────────────────────────────────────────────────────────────────────

# X rd  ->  X^(...)
context "math()"
snippet "([A-Za-z0-9\)\}\]])rd" "superscript" rA
`!p snip.rv = match.group(1)`^($0)
endsnippet

# X __  ->  X_(...)
context "math()"
snippet "([A-Za-z0-9\)\}\]])__" "subscript" rA
`!p snip.rv = match.group(1)`_($0)
endsnippet

# Matrices are the only Typst math construct worth a skeleton: rows are
# separated by ; and columns by , so the shape is tedious to type by hand.
context "math()"
snippet mat "matrix (3x3, brackets)" i
mat(
  delim: "[",
  $1, $2, $3;
  $4, $5, $6;
  $7, $8, $9
)$0
endsnippet

context "math()"
snippet det "determinant (3x3)" i
mat(
  delim: "|",
  $1, $2, $3;
  $4, $5, $6;
  $7, $8, $9
)$0
endsnippet

# augment: #n draws a vertical rule after column n.
context "math()"
snippet aug "augmented matrix" i
mat(
  delim: "[",
  augment: #${1:2},
  $2, $3, $4;
  $5, $6, $7
)$0
endsnippet

