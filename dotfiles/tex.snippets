
# Define math environment to limit scope in which snippets are triggered.
global !p
def math():
  return vim.eval('vimtex#syntax#in_mathzone()') == '1'
endglobal

# Usage
# ====
# In same folder as this doc, put:
# homework.tex
# logo_goethe_uni.png

# 1. General Snippets
snippet homework "homework snippet" i
\documentclass[11pt, a4paper]{article}

\include{homework.tex}

\usepackage{amssymb}
\usepackage{amsmath}
\usepackage{indentfirst}
\usepackage{enumitem}
\usepackage{geometry}
\usepackage{tikz}
\usepackage{xcolor}
\usepackage{listings}
\usepackage{algorithm}
\usepackage{algorithmicx}
\usepackage{algpseudocode}
\usepackage{fancyhdr}
\usepackage{ifthen}
\usepackage{xstring}
\usepackage{calc}
\usepackage{pgfopts}
\usetikzlibrary{automata}


\lstdefinestyle{mystyle}{
    language=Python,               % Specify Python syntax highlighting
    basicstyle=\ttfamily\small,    % Use a small, monospace font
    keywordstyle=\color{blue},     % Keywords in blue
    stringstyle=\color{red},       % Strings in red
    commentstyle=\color{gray},    % Comments in green
    morecomment=[s][\color{gray}]{"""}{"""},
    breakatwhitespace=false,       % Break lines at whitespace (optional)
    breaklines=true,               % Automatic line breaking
    captionpos=b,                  % Caption position at the bottom
    keepspaces=true,               % Keeps spaces in text
    showspaces=false,              % Don't show spaces with underscores
    showstringspaces=false,        % Don't show spaces in strings
    showtabs=false,                % Don't show tabs within strings
    tabsize=2,                      % Set tab size
    numbers=left,                           % Line numbers on the left
    numberstyle=\tiny\color{gray},          % Line numbers styling
    stepnumber=1,                           % Line number step
    numbersep=10pt,                         % How far the line numbers are from the code
}

%%%%%%%%%%%%%%%
\usepackage{venndiagram}
\usepackage{colortbl}
\usepackage{indentfirst}
\usepackage{amsmath}
\usepackage{amssymb}

% You can use <c-j> to jump to the next tabstop, and <c-k> to jump to the previous. 
\module{$1}
\title{$2}
\date{\today}
\semester{$3}
\fromdate{$4}
\todate{$5}
\author{Joshua Spingler}

\begin{document}

\maketitle

$0

\end{document}
endsnippet

snippet standard "standard tex doc" i
\documentclass[11pt, a4paper]{article}
\usepackage{amssymb}
\usepackage{amsmath}
\usepackage{indentfirst}
\usepackage{enumitem}
\usepackage{geometry}
\usepackage{tikz}
\usepackage{xcolor}
\usepackage{listings}
\usetikzlibrary{automata}

\lstdefinestyle{mystyle}{
    language=python,               % specify python syntax highlighting
    basicstyle=\ttfamily\small,    % use a small, monospace font
    keywordstyle=\color{blue},     % keywords in blue
    stringstyle=\color{red},       % strings in red
    commentstyle=\color{gray},    % comments in green
    morecomment=[s][\color{gray}]{"""}{"""},
    breakatwhitespace=false,       % break lines at whitespace (optional)
    breaklines=true,               % automatic line breaking
    captionpos=b,                  % caption position at the bottom
    keepspaces=true,               % keeps spaces in text
    showspaces=false,              % don't show spaces with underscores
    showstringspaces=false,        % don't show spaces in strings
    showtabs=false,                % don't show tabs within strings
    tabsize=2,                      % set tab size
    numbers=left,                           % line numbers on the left
    numberstyle=\tiny\color{gray},          % line numbers styling
    stepnumber=1,                           % line number step
    numbersep=10pt,                         % how far the line numbers are from the code
}

\title{\textbf{$3}}
\author{$2}
\date{$1}
\geometry{margin=2cm}

\begin{document}

\maketitle
\noindent \line(1,0){17cm}

$0

\end{document}
endsnippet

# 1. General Snippets
snippet sec "section" i 
\section*{$0}
endsnippet

snippet sub "subsection" i
\subsection*{$0}
endsnippet

snippet mk "inline math" A
$$0$
endsnippet

snippet dm "display math" A
$$
$0
$$
endsnippet

snippet align "Aligned equations" i
\begin{align}
$0
\end{align}
endsnippet

# 2. Math env snippets
context "math()"
snippet "([A-Za-z0-9\(\)\{\}\[\]])rd" "^{$0}" rA
`!p snip.rv = match.group(1)`^{$0}
endsnippet

context "math()"
snippet "([A-Za-z0-9\(\)\{\}\[\]])__" "_{$0}" rA
`!p snip.rv = match.group(1)`_{$0}
endsnippet

context "math()"
snippet text "text field" iA
\text{$1}$0
endsnippet

context "math()"
snippet inn "\in" iA
\in$0
endsnippet

context "math()"
snippet set "set" i
\\{$1\\}$0
endsnippet

context "math()"
snippet ... "\dots" i
\dots$0
endsnippet

context "math()"
snippet PP "\mathbb{P}" iA
\mathbb{P}$0
endsnippet

# Numbers
context "math()"
snippet NN "\mathbb{N}" iA
\mathbb{N}$0
endsnippet

context "math()"
snippet ZZ "\mathbb{Z}" iA
\mathbb{Z}$0
endsnippet

context "math()"
snippet RR "\mathbb{R}" iA
\mathbb{R}$0
endsnippet

# Greek letters
context "math()"
snippet alpha "Greek letter alpha" iA
\alpha$0
endsnippet

context "math()"
snippet beta "Greek letter beta" iA
\beta$0
endsnippet

context "math()"
snippet gamma "Greek letter gamma" iA
\gamma$0
endsnippet

context "math()"
snippet delta "Greek letter delta" iA
\delta$0
endsnippet

context "math()"
snippet epsilon "Greek letter epsilon" iA
\epsilon$0
endsnippet

context "math()"
snippet theta "Greek letter theta" iA
\theta$0
endsnippet

context "math()"
snippet iota "Greek letter iota" iA
\iota$0
endsnippet

context "math()"
snippet kappa "Greek letter kappa" iA
\kappa$0
endsnippet

context "math()"
snippet lambda "Greek letter lambda" iA
\lambda$0
endsnippet

context "math()"
snippet mu "Greek letter mu" iA
\mu$0
endsnippet

context "math()"
snippet xi "Greek letter xi" iA
\xi$0
endsnippet

context "math()"
snippet pi "Greek letter pi" iA
\pi$0
endsnippet

context "math()"
snippet rho "Greek letter rho" iA
\rho$0
endsnippet

context "math()"
snippet sigma "Greek letter sigma" iA
\sigma$0
endsnippet

context "math()"
snippet tau "Greek letter tau" iA
\tau$0
endsnippet

context "math()"
snippet phi "Greek letter phi" iA
\phi$0
endsnippet

context "math()"
snippet chi "Greek letter chi" iA
\chi$0
endsnippet

context "math()"
snippet psi "Greek letter psi" iA
\psi$0
endsnippet

context "math()"
snippet Omega "Greek letter Omega" iA
\Omega$0
endsnippet

context "math()"
snippet omega "Greek letter omega" iA
\omega$0
endsnippet

# Matrices
context "math()"
snippet matrix "Matrix (3x3 default)" iA
\begin{bmatrix}
	$1 &$2 &$3 \\
	$4 &$5 &$6 \\
	$7 &$8 &$9
\end{bmatrix}$0
endsnippet

context "math()"
snippet pmatrix "Parenthesized Matrix" iA
\begin{pmatrix}
	$1 &$2 &$3 \\
	$4 &$5 &$6 \\
	$7 &$8 &$9
\end{pmatrix}$0
endsnippet

context "math()"
snippet vmatrix "Determinant" iA
\begin{vmatrix}
	$1 &$2 &$3 \\
	$4 &$5 &$6 \\
	$7 &$8 &$9
\end{vmatrix}$0
endsnippet

# Custom size matrix
context "math()"
snippet cmatrix "Custom matrix" iA
\begin{bmatrix}
	${1:row1col1} &${2:row1col2} \\
	${3:row2col1} &${4:row2col2}
\end{bmatrix}${0}
endsnippet

# Inline matrix
context "math()"
snippet imatrix "Inline matrix" iA
\begin{smallmatrix} $1 & $2 \\ $3 & $4 \end{smallmatrix}$0
endsnippet

# Vector
context "math()"
snippet vec "Vector (column)" iA
\begin{bmatrix}
	$1 \\
	$2 \\
	$3
\end{bmatrix}$0
endsnippet

# Diagonal matrix
context "math()"
snippet diag "Diagonal matrix" iA
\begin{bmatrix}
	$1 & 0 & 0 \\
	0 & $2 & 0 \\
	0 & 0 & $3
\end{bmatrix}$0
endsnippet

# Identity matrix (2x2, 3x3)
context "math()"
snippet id "Identity matrix" iA
\begin{bmatrix}
	1 & 0 & 0 \\
	0 & 1 & 0 \\
	0 & 0 & 1
\end{bmatrix}$0
endsnippet

# Augmented matrix
context "math()"
snippet aug "Augmented matrix" iA
\left[
\begin{array}{${1:cc}|c}
	$2 & $3 & $4 \\
	$5 & $6 & $7
\end{array}
\right]$0
endsnippet

# Fraction
context "math()"
snippet frac "Fraction" iA
\frac{$1}{$2}$0
endsnippet

# Binomial Coefficient
context "math()"
snippet binom "Binomial Coefficient" iA
\binom{$1}{$2}$0
endsnippet

# Square root
context "math()"
snippet sqrt "Square root" iA
\sqrt{$1}$0
endsnippet

# Superscript
context "math()"
snippet ^ "Superscript" iA
^{$1}$0
endsnippet

# Subscript
context "math()"
snippet _ "Subscript" iA
_{$1}$0
endsnippet

snippet begin "begin{} / end{}" iA
\begin{$1}
	$0
\end{$1}
endsnippet

